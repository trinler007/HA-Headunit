          "speedKph": "Speed (e.g. speedometer sensor)",
          "reverse": "Reverse gear",
          "gear": "Gear",
          "parkingBrake": "Parking brake",
          "lights": "Low beam",
          "highBeam": "High beam",
          "hazards": "Hazard lights",
          "nightMode": "Night mode",
          "fuelPct": "Fuel level (%)",
          "rangeKm": "Range",
          "odometerKm": "Odometer",
          "ambientC": "Outside temperature",
          "coolantC": "Coolant temperature",
          "batteryV": "Battery voltage",
          "rpm": "Engine speed"
        }
      },
      "gps": {
        "title": "GPS",

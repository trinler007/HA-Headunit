        "data": {
          "gps_tracker": "Position tracker",
          "gps_altitude": "Altitude",
          "gps_speed": "Speed (GPS)",
          "gps_heading": "Heading",
          "gps_accuracy": "Accuracy (m)"
        }
      },
      "camview": {
        "title": "Cameras (camview)",
        "data": {
          "camview_enabled": "Use camview",
          "camview_port": "Port",
          "camview_token": "API-Token",
          "reverse_camera": "Show cameras in reverse",
          "reverse_layout": "Reverse layout",
          "reverse_hide_delay": "Hide after (s)"
        }
      }
